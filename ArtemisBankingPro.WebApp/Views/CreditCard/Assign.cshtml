@model ArtemisBankingPro.WebApp.ViewModels.AssignCreditCardViewModel

@{
    ViewData["Title"] = "Asignar Tarjeta de Crédito";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4">Asignar Tarjeta de Crédito</h2>

    <div class="card shadow border-0" style="max-width: 500px;">
        <div class="card-body">
            <form asp-action="Assign" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

                <input type="hidden" asp-for="ClientId" />

                <div class="mb-3">
                    <label asp-for="CreditLimit" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">RD$</span>
                        <input asp-for="CreditLimit" class="form-control" step="0.01" min="0.01" />
                    </div>
                    <span asp-validation-for="CreditLimit" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="SelectClient" class="btn btn-outline-secondary">Volver atrás</a>
                    <button type="submit" class="btn btn-primary">Asignar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}