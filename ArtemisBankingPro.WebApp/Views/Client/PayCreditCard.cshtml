@{
    ViewData["Title"] = "Pagar Tarjeta de Crédito";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Pagar Tarjeta de Crédito</h2>
    <p class="text-muted">Tarjeta No: @ViewBag.CardNumber</p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm border-0 mt-3">
        <div class="card-body p-4">
            <form asp-action="PayCreditCard" method="post">
                <input type="hidden" name="cardNumber" value="@ViewBag.CardNumber" />

                <div class="mb-3">
                    <label class="form-label">Pagar Desde Cuenta de Ahorro</label>
                    <select name="sourceAccountNumber" class="form-select" required>
                        <option value="">Seleccione cuenta origen...</option>
                        @foreach (var acc in (IEnumerable<ArtemisBankingPro.Application.DTOs.Account.SavingsAccountListItemDto>)ViewBag.Accounts)
                        {
                            <option value="@acc.AccountNumber">@acc.AccountNumber - RD$ @acc.Balance.ToString("N2")</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Monto a Pagar (RD$)</label>
                    <input name="amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="Monto del pago" required />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success">Efectuar Pago</button>
                </div>
            </form>
        </div>
    </div>
</div>
