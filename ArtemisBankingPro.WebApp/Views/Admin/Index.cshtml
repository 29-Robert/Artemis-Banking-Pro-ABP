@using ArtemisBankingPro.Application.DTOs.Admin
@model AdminHomeIndicatorsDto

@{
    ViewData["Title"] = "Panel del Administrador";
    var userName = User.Identity?.Name ?? "Administrador";
    var hour = DateTime.Now.Hour;
    var saludo = hour < 12 ? "Buenos días" : hour < 19 ? "Buenas tardes" : "Buenas noches";
}

<div class="container mt-4 mb-5">

    @* Bienvenida *@
    <div class="container mt-4">
        <div class="row mb-5">
            <div class="col-12 text-center">
                <h1 class="display-5 fw-bold" style="color: var(--abp-primary);">Bienvenido a Artemis Banking Pro</h1>
                <p class="lead text-muted">Hola, <strong>@User.Identity?.Name</strong>. ¡Qué bueno tenerte en el sistema!</p>
            </div>
        </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Transacciones y pagos *@
    <h5 class="text-muted mb-3">Actividad del Sistema</h5>
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <small class="text-muted d-block">Transacciones Históricas</small>
                            <h3 class="mb-0 fw-bold">@Model.TotalTransactionsHistorical</h3>
                        </div>
                        <span class="fs-3">📊</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <small class="text-muted d-block">Transacciones Hoy</small>
                            <h3 class="mb-0 fw-bold text-primary">@Model.TotalTransactionsToday</h3>
                        </div>
                        <span class="fs-3">🕐</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <small class="text-muted d-block">Pagos Históricos</small>
                            <h3 class="mb-0 fw-bold">@Model.TotalPaymentsHistorical</h3>
                        </div>
                        <span class="fs-3">💳</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <small class="text-muted d-block">Pagos Hoy</small>
                            <h3 class="mb-0 fw-bold text-primary">@Model.TotalPaymentsToday</h3>
                        </div>
                        <span class="fs-3">✅</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Clientes y productos *@
    <h5 class="text-muted mb-3">Clientes y Productos Financieros</h5>
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100 border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <small class="text-muted d-block">Clientes Activos</small>
                            <h3 class="mb-0 fw-bold text-success">@Model.ActiveClients</h3>
                        </div>
                        <span class="fs-3">🟢</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100 border-start border-4 border-secondary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <small class="text-muted d-block">Clientes Inactivos</small>
                            <h3 class="mb-0 fw-bold text-secondary">@Model.InactiveClients</h3>
                        </div>
                        <span class="fs-3">⚪</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <small class="text-muted d-block">Productos Financieros Activos</small>
                            <h3 class="mb-0 fw-bold">@Model.ActiveFinancialProducts</h3>
                        </div>
                        <span class="fs-3">🏦</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 h-100 border-start border-4 border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <small class="text-muted d-block">Deuda Promedio / Cliente</small>
                            <h3 class="mb-0 fw-bold text-danger">RD$ @Model.AverageDebtPerClient.ToString("N2")</h3>
                        </div>
                        <span class="fs-3">💰</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Accesos rápidos *@
    <h5 class="text-muted mb-3">Accesos Rápidos</h5>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-primary">👤 Gestión de Usuarios</a>
        <a asp-controller="Loan" asp-action="Index" class="btn btn-outline-primary">💵 Préstamos</a>
        <a asp-controller="CreditCard" asp-action="Index" class="btn btn-outline-primary">💳 Tarjetas de Crédito</a>
        <a asp-controller="Commerce" asp-action="Index" class="btn btn-outline-primary">🏢 Comercios</a>
    </div>

</div>