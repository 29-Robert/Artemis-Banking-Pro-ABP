@{
    ViewData["Title"] = "Avance de Efectivo";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Avance de Efectivo</h2>
    <p class="text-muted">Tarjeta No: @ViewBag.CardNumber</p>
    <div class="alert alert-info">
        <strong>Nota importante:</strong> Los avances de efectivo están sujetos a una comisión del <strong>6.25%</strong> sobre el monto solicitado, la cual será cargada de forma inmediata a la deuda de la tarjeta.
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm border-0 mt-3">
        <div class="card-body p-4">
            <form asp-action="CashAdvance" method="post">
                <input type="hidden" name="cardNumber" value="@ViewBag.CardNumber" />

                <div class="mb-3">
                    <label class="form-label">Depositar en Cuenta de Ahorro</label>
                    <select name="sourceAccountNumber" class="form-select" required>
                        <option value="">Seleccione cuenta destino...</option>
                        @foreach (var acc in (IEnumerable<ArtemisBankingPro.Application.DTOs.Account.SavingsAccountListItemDto>)ViewBag.Accounts)
                        {
                            <option value="@acc.AccountNumber">@acc.AccountNumber - RD$ @acc.Balance.ToString("N2")</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Monto del Avance (RD$)</label>
                    <input name="amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="Monto a avanzar" required />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-warning text-dark">Procesar Avance</button>
                </div>
            </form>
        </div>
    </div>
</div>
