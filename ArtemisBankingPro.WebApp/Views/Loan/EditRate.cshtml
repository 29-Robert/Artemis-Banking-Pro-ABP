@model ArtemisBankingPro.WebApp.ViewModels.EditLoanRateViewModel

@{
    ViewData["Title"] = "Editar Tasa de Interés";
}

<div class="container mt-4 mb-5" style="max-width: 560px;">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Details" asp-route-id="@Model.LoanId"
           class="btn btn-outline-secondary btn-sm me-3">&larr; Volver</a>
        <h2 class="mb-0">Editar Tasa de Interés</h2>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-4">

            @* Datos actuales del préstamo *@
            <div class="alert alert-info mb-4">
                <div class="row">
                    <div class="col-6">
                        <small class="text-muted d-block">No. Préstamo</small>
                        <code>@Model.LoanNumber</code>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Tasa Actual</small>
                        <strong>@Model.CurrentRate.ToString("N2")%</strong> anual
                    </div>
                </div>
            </div>

            <div class="alert alert-warning py-2 mb-4">
                <small>
                    ℹ️ Al actualizar la tasa, <strong>solo se recalculan las cuotas futuras pendientes</strong>.
                    Las cuotas ya pagadas no se modifican.
                </small>
            </div>

            <form asp-action="EditRate" method="post">
                <input asp-for="LoanId" type="hidden" />
                <input asp-for="LoanNumber" type="hidden" />
                <input asp-for="CurrentRate" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="NewRate" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="NewRate" type="number" step="0.01" min="0.01" max="100"
                               class="form-control" placeholder="Ej: 14.00" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="NewRate" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4 fw-semibold">Actualizar Tasa</button>
                    <a asp-action="Details" asp-route-id="@Model.LoanId"
                       class="btn btn-outline-secondary px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
