@model ArtemisBankingPro.Application.DTOs.Beneficiaries.CreateBeneficiaryDto
@{
    ViewData["Title"] = "Agregar Beneficiario";
}

<div class="container mt-4" style="max-width: 500px;">
    <h2>Agregar Nuevo Beneficiario</h2>

    <div class="card shadow-sm border-0 mt-3">
        <div class="card-body p-4">
            <form asp-action="AddBeneficiary" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Número de Cuenta de Ahorro</label>
                    <input asp-for="AccountNumber" class="form-control" placeholder="Ej. 123456789" required />
                    <span asp-validation-for="AccountNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Nombre / Alias del Beneficiario</label>
                    <input asp-for="Alias" class="form-control" placeholder="Ej. Juan Pérez" required />
                    <span asp-validation-for="Alias" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Beneficiaries" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar Beneficiario</button>
                </div>
            </form>
        </div>
    </div>
</div>
