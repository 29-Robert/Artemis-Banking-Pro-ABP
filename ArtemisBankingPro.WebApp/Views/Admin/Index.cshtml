@model IEnumerable<ArtemisBankingPro.Application.DTOs.UserDto>

@{
    ViewData["Title"] = "Panel de Administrador";
}
<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Usuarios</h2>
        <a asp-action="Create" class="btn btn-primary">Crear usuario</a>
    </div>

    <div class="card shadow border-0 mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row gx-3 gy-2 align-items-center">
                <div class="col-sm-4">
                    <select name="roleFilter" id="roleFilter" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty((string)ViewBag.RoleFilter) ? "selected" : null)">Todos (Excluye Comercio)</option>
                        <option value="Administrador" selected="@((string)ViewBag.RoleFilter == "Administrador" ? "selected" : null)">Administrador</option>
                        <option value="Cajero" selected="@((string)ViewBag.RoleFilter == "Cajero" ? "selected" : null)">Cajero</option>
                        <option value="Cliente" selected="@((string)ViewBag.RoleFilter == "Cliente" ? "selected" : null)">Cliente</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre Completo</th>
                            <th>Usuario</th>
                            <th>Correo</th>
                            <th>Cédula</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.FirstName @user.LastName</td>
                                <td>@user.Username</td>
                                <td>@user.Email</td>
                                <td>@user.Cedula</td>
                                <td>
                                    @(user.RoleId switch
                                    {
                                        1 => "Administrador",
                                        2 => "Cajero",
                                        3 => "Cliente",
                                        4 => "Comercio",
                                        _ => "Desconocido"
                                    })
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex flex-column gap-1">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Editar</a>

                                        <form asp-action="ToggleStatus" method="post" class="d-inline m-0">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            @if (user.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">Inactivar</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success w-100">Activar</button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <nav aria-label="Navegación de páginas">
        <ul class="pagination justify-content-center mt-4">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-roleFilter="@ViewBag.RoleFilter">Anterior</a>
            </li>
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-roleFilter="@ViewBag.RoleFilter">@i</a>
                </li>
            }
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-roleFilter="@ViewBag.RoleFilter">Siguiente</a>
            </li>
        </ul>
    </nav>
</div>