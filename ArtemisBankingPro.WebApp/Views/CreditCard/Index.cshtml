 @using ArtemisBankingPro.Application.DTOs.CreditCard
@model IReadOnlyList<CreditCardResponseDto>

@{
    ViewData["Title"] = "Gestión de Tarjetas de Crédito";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Tarjetas de Crédito</h2>
        <a asp-action="SelectClient" class="btn btn-primary">Asignar Tarjeta</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Filtros *@
    <div class="card shadow border-0 mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row gx-3 gy-2 align-items-center">
                <div class="col-sm-4">
                    <input type="text" name="cedula" value="@ViewBag.Cedula"
                           class="form-control" placeholder="Buscar por cédula..." />
                </div>
                <div class="col-sm-3">
                    <select name="status" class="form-select">
                        <option value="">Todos los estados</option>
                        <option value="Activa"    selected="@((string)ViewBag.Status == "Activa"    ? "selected" : null)">Activa</option>
                        <option value="Cancelada" selected="@((string)ViewBag.Status == "Cancelada" ? "selected" : null)">Cancelada</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
                </div>
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    @* Tabla *@
    <div class="card shadow border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>No. Tarjeta</th>
                            <th>Cliente</th>
                            <th>Límite</th>
                            <th>Crédito Disponible</th>
                            <th>Deuda Actual</th>
                            <th>Vencimiento</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No se encontraron tarjetas.</td>
                            </tr>
                        }
                        @foreach (var card in Model)
                        {
                            <tr>
                                <td><code>@card.MaskedCardNumber</code></td>
                                <td>@card.ClientFullName</td>
                                <td>RD$ @card.CreditLimit.ToString("N2")</td>
                                <td>
                                    <span class="@(card.AvailableCredit < card.CreditLimit * 0.2m ? "text-danger fw-bold" : "")">
                                        RD$ @card.AvailableCredit.ToString("N2")
                                    </span>
                                </td>
                                <td>RD$ @card.CurrentDebt.ToString("N2")</td>
                                <td>@card.ExpirationDate</td>
                                <td>
                                    @{
                                        var badgeClass = card.Status == "Activa" ? "bg-success" : "bg-secondary";
                                    }
                                    <span class="badge @badgeClass">@card.Status</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center flex-wrap">
                                        <a asp-action="Details" asp-route-id="@card.Id"
                                           class="btn btn-sm btn-outline-info">Ver</a>
                                        @if (card.Status == "Activa")
                                        {
                                            <a asp-action="EditLimit" asp-route-id="@card.Id"
                                               class="btn btn-sm btn-outline-warning">Límite</a>
                                            <form asp-action="Cancel" method="post" class="d-inline m-0"
                                                  onsubmit="return confirm('¿Desea cancelar esta tarjeta?')">
                                                <input type="hidden" name="id" value="@card.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Paginación *@
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Paginación de tarjetas" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-cedula="@ViewBag.Cedula"
                       asp-route-status="@ViewBag.Status">Anterior</a>
                </li>
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-cedula="@ViewBag.Cedula"
                           asp-route-status="@ViewBag.Status">@i</a>
                    </li>
                }
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-cedula="@ViewBag.Cedula"
                       asp-route-status="@ViewBag.Status">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>
