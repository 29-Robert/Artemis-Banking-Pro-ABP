@model IEnumerable<ArtemisBankingPro.Domain.Entities.SavingsAccount>
@{
    ViewData["Title"] = "Gestión de Cuentas de Ahorro";
}

<div class="container mt-4">
    <h2>Gestión de Cuentas de Ahorro</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <!-- Filtros -->
    <form method="get" class="row g-3 mb-4 mt-2">
        <div class="col-md-3">
            <label class="form-label">Filtrar por Cédula</label>
            <input type="text" name="cedula" value="@ViewBag.CedulaFilter" class="form-control" placeholder="Cédula del cliente" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Estado</label>
            <select name="status" class="form-select">
                <option value="">Todos</option>
                <option value="0" selected="@(ViewBag.StatusFilter != null && (int)ViewBag.StatusFilter == 0)">Activa</option>
                <option value="1" selected="@(ViewBag.StatusFilter != null && (int)ViewBag.StatusFilter == 1)">Cancelada</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Tipo</label>
            <select name="type" class="form-select">
                <option value="">Todos</option>
                <option value="0" selected="@(ViewBag.TypeFilter != null && (int)ViewBag.TypeFilter == 0)">Principal</option>
                <option value="1" selected="@(ViewBag.TypeFilter != null && (int)ViewBag.TypeFilter == 1)">Secundaria</option>
            </select>
        </div>
        <div class="col-md-3 align-self-end">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
        </div>
    </form>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning">@ViewBag.Message</div>
    }

    <div class="mb-3">
        <a asp-action="SelectClient" class="btn btn-success">Asignar cuenta de ahorro</a>
    </div>

    <!-- Tabla -->
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Número de Cuenta</th>
                <th>Cliente</th>
                <th>Cédula</th>
                <th>Balance</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Bloqueos</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AccountNumber</td>
                    <td>@(item.User != null ? $"{item.User.FirstName} {item.User.LastName}" : "N/A")</td>
                    <td>@(item.User != null ? item.User.Cedula : "N/A")</td>
                    <td>RD$ @item.Balance.ToString("N2")</td>
                    <td>
                        <span class="badge @(item.Type == ArtemisBankingPro.Domain.Enums.AccountType.Principal ? "bg-primary" : "bg-info")">
                            @item.Type
                        </span>
                    </td>
                    <td>
                        <span class="badge @(item.Status == ArtemisBankingPro.Domain.Enums.AccountStatus.Activa ? "bg-success" : "bg-danger")">
                            @item.Status
                        </span>
                    </td>
                    <td>
                        @if (item.IsBlocked)
                        {
                            <span class="badge bg-danger d-block mb-1">Bloqueada</span>
                        }
                        @if (item.BlockedAmount > 0)
                        {
                            <span class="badge bg-warning text-dark d-block">Retenido: RD$ @item.BlockedAmount.ToString("N2")</span>
                        }
                        @if (!item.IsBlocked && item.BlockedAmount == 0)
                        {
                            <span class="badge bg-secondary">Ninguno</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-accountNumber="@item.AccountNumber" class="btn btn-sm btn-outline-secondary">Historial</a>
                        @if (item.Status == ArtemisBankingPro.Domain.Enums.AccountStatus.Activa)
                        {
                            @if (item.IsBlocked)
                            {
                                <form asp-action="UnblockAccount" method="post" class="d-inline">
                                    <input type="hidden" name="accountNumber" value="@item.AccountNumber" />
                                    <button type="submit" class="btn btn-sm btn-success">Desbloquear</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="BlockAccount" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de bloquear la cuenta @item.AccountNumber?');">
                                    <input type="hidden" name="accountNumber" value="@item.AccountNumber" />
                                    <button type="submit" class="btn btn-sm btn-warning text-dark">Bloquear</button>
                                </form>
                            }
                            
                            <button type="button" class="btn btn-sm btn-info text-white" data-bs-toggle="collapse" data-bs-target="#retention-@item.AccountNumber">Retener</button>
                            
                            @if (item.Type == ArtemisBankingPro.Domain.Enums.AccountType.Secundaria)
                            {
                                <a asp-action="CancelConfirm" asp-route-accountNumber="@item.AccountNumber" class="btn btn-sm btn-danger">Cancelar</a>
                            }
                            
                            <div class="collapse mt-2" id="retention-@item.AccountNumber">
                                <form asp-action="SetBlockedAmount" method="post" class="input-group input-group-sm" style="max-width: 250px;">
                                    <input type="hidden" name="accountNumber" value="@item.AccountNumber" />
                                    <input type="number" name="amount" value="@item.BlockedAmount" step="0.01" min="0" class="form-control" placeholder="Monto retención" required />
                                    <button type="submit" class="btn btn-primary">Fijar</button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Paginación -->
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i&status=@ViewBag.StatusFilter&type=@ViewBag.TypeFilter&cedula=@ViewBag.CedulaFilter">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>