@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-4">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-bold" style="color: var(--abp-primary);">Bienvenido a Artemis Banking Pro</h1>
            <p class="lead text-muted">Hola, <strong>@User.Identity?.Name</strong>. ¡Qué bueno tenerte en el sistema!</p>
        </div>
    </div>

    <div class="row justify-content-center g-4">

        @if (User.IsInRole("Administrador"))
        {
            <div class="col-md-4">
                <div class="card stat-card h-100">
                    <div class="card-body text-center p-4">
                        <div class="mb-3"><span style="font-size: 2.5rem;">👥</span></div>
                        <h5 class="card-title fw-bold">Gestión de Usuarios</h5>
                        <p class="card-text text-muted small">Administra usuarios, roles y permisos del sistema.</p>
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-primary w-100">Ir a Usuarios</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card stat-card h-100">
                    <div class="card-body text-center p-4">
                        <div class="mb-3"><span style="font-size: 2.5rem;">🏦</span></div>
                        <h5 class="card-title fw-bold">Cuentas de Ahorro</h5>
                        <p class="card-text text-muted small">Gestiona cuentas principales y secundarias de clientes.</p>
                        <a asp-controller="SavingsAccount" asp-action="Index" class="btn btn-primary w-100">Ir a Cuentas</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card stat-card h-100">
                    <div class="card-body text-center p-4">
                        <div class="mb-3"><span style="font-size: 2.5rem;">💳</span></div>
                        <h5 class="card-title fw-bold">Productos Financieros</h5>
                        <p class="card-text text-muted small">Administra préstamos y tarjetas de crédito.</p>
                        <div class="d-grid gap-2">
                            <a asp-controller="Loan" asp-action="Index" class="btn btn-outline-primary">Préstamos</a>
                            <a asp-controller="CreditCard" asp-action="Index" class="btn btn-outline-primary">Tarjetas</a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (User.IsInRole("Cliente"))
        {
            <div class="col-md-5">
                <div class="card stat-card h-100">
                    <div class="card-body text-center p-4">
                        <div class="mb-3"><span style="font-size: 2.5rem;">💰</span></div>
                        <h5 class="card-title fw-bold">Mis Productos</h5>
                        <p class="card-text text-muted">Consulta tus cuentas, tarjetas, préstamos y realiza transferencias.</p>
                        <a asp-controller="Client" asp-action="Index" class="btn btn-success w-100">Ver mis cuentas y productos</a>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card stat-card h-100">
                    <div class="card-body text-center p-4">
                        <div class="mb-3"><span style="font-size: 2.5rem;">📋</span></div>
                        <h5 class="card-title fw-bold">Beneficiarios</h5>
                        <p class="card-text text-muted">Administra tus beneficiarios y realiza transferencias rápidas.</p>
                        <a asp-controller="Client" asp-action="Beneficiaries" class="btn btn-outline-success w-100">Ir a Beneficiarios</a>
                    </div>
                </div>
            </div>
        }

        @if (User.IsInRole("Cajero"))
        {
            <div class="col-md-6">
                <div class="card stat-card h-100">
                    <div class="card-body text-center p-4">
                        <div class="mb-3"><span style="font-size: 2.5rem;">🏧</span></div>
                        <h5 class="card-title fw-bold">Operaciones de Caja</h5>
                        <p class="card-text text-muted">Realiza depósitos, retiros, pagos de tarjeta, préstamos y transferencias a terceros.</p>
                        <a asp-controller="Cashier" asp-action="Index" class="btn btn-warning w-100 text-dark">Ir a Caja</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>