@model ArtemisBankingPro.WebApp.ViewModels.AssignCreditCardViewModel

@{
    ViewData["Title"] = "Asignar Tarjeta de Crédito";
}

<div class="container mt-4 mb-5" style="max-width: 600px;">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="SelectClient" class="btn btn-outline-secondary btn-sm me-3">&larr; Volver atrás</a>
        <h2 class="mb-0">Asignar Tarjeta de Crédito</h2>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-4">
            <form asp-action="Assign" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="ClientId" type="hidden" />

                <div class="mb-3">
                    <label asp-for="CreditLimit" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text">RD$</span>
                        <input asp-for="CreditLimit" class="form-control" />
                    </div>
                    <span asp-validation-for="CreditLimit" class="text-danger d-block"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Asignar Tarjeta</button>
                    <a asp-action="SelectClient" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>