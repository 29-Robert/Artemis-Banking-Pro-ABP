@using ArtemisBankingPro.Application.DTOs.CreditCard
@model EligibleClientsResponseDto

@{
    ViewData["Title"] = "Seleccionar Cliente";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Asignar Tarjeta de Crédito — Seleccionar Cliente</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver atrás</a>
    </div>

    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <span>Deuda promedio de los clientes activos del sistema</span>
        <strong>RD$ @Model.SystemAverageDebt.ToString("N2")</strong>
    </div>

    <div class="card shadow border-0 mb-4">
        <div class="card-body">
            <form method="get" asp-action="SelectClient" class="row gx-3 gy-2 align-items-center">
                <div class="col-sm-5">
                    <input type="text" name="cedula" value="@ViewBag.Cedula"
                           class="form-control" placeholder="Buscar por cédula..." />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-secondary">Buscar</button>
                </div>
                <div class="col-auto">
                    <a asp-action="SelectClient" class="btn btn-outline-danger">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <form asp-action="SelectClient" method="post">
        <input type="hidden" name="Cedula" value="@ViewBag.Cedula" />

        <div class="card shadow border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th></th>
                                <th>Cédula</th>
                                <th>Nombre y Apellido</th>
                                <th>Correo</th>
                                <th>Deuda Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Clients.Items.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No se encontraron clientes.</td>
                                </tr>
                            }
                            @foreach (var client in Model.Clients.Items)
                            {
                                <tr>
                                    <td>
                                        <input class="form-check-input" type="radio"
                                               name="SelectedClientId" value="@client.Id" required />
                                    </td>
                                    <td>@client.Cedula</td>
                                    <td>@client.FullName</td>
                                    <td>@client.Email</td>
                                    <td>RD$ @client.TotalDebt.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger mt-3">
                @ViewData.ModelState[string.Empty].Errors.First().ErrorMessage
            </div>
        }

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver atrás</a>
            <button type="submit" class="btn btn-primary">Siguiente paso</button>
        </div>
    </form>

    @if (Model.Clients.TotalPages > 1)
    {
        <nav aria-label="Paginación de clientes" class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.Clients.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="SelectClient" asp-route-page="@i" asp-route-cedula="@ViewBag.Cedula">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>