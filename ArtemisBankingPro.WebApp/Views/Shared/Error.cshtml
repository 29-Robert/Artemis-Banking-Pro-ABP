@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="card border-0">
            <div class="card-body text-center p-5">
                <div class="mb-4">
                    <span style="font-size: 4rem;">⚠️</span>
                </div>
                <h2 class="text-danger fw-bold mb-3">Ha ocurrido un error</h2>
                <p class="text-muted mb-4">Lo sentimos, algo salió mal al procesar su solicitud. Por favor, intente nuevamente.</p>

                @if (Model?.ShowRequestId ?? false)
                {
                    <p class="text-muted small">
                        <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                <a href="/Home/Index" class="btn btn-primary mt-2">Volver al Inicio</a>
            </div>
        </div>
    </div>
</div>
