@using ArtemisBankingPro.WebApp.Models
@model DepositViewModel

@{
    ViewData["Title"] = "Depósito";
}

<div class="container mt-4 mb-5" style="max-width:560px;">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">&larr; Volver</a>
        <h2 class="mb-0">💰 Depósito</h2>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-4">
            <form asp-action="Deposit" method="post" id="depositForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="DestinationAccountNumber" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="DestinationAccountNumber" id="accountNumberInput" class="form-control"
                               placeholder="Número de cuenta destino" autocomplete="off" />
                        <button type="button" id="verifyBtn" class="btn btn-outline-primary">Verificar</button>
                    </div>
                    <span asp-validation-for="DestinationAccountNumber" class="text-danger small"></span>
                </div>

                <div id="previewBox" class="mb-3 p-3 rounded d-none"></div>

                <div class="mb-4">
                    <label asp-for="Amount" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text">RD$</span>
                        <input asp-for="Amount" type="number" step="0.01" min="0.01"
                               class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" id="submitBtn" class="btn btn-success px-4 fw-semibold" disabled>
                        Realizar Depósito
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const accountInput = document.getElementById('accountNumberInput');
            const verifyBtn = document.getElementById('verifyBtn');
            const previewBox = document.getElementById('previewBox');
            const submitBtn = document.getElementById('submitBtn');

            function resetPreview() {
                previewBox.classList.add('d-none');
                previewBox.innerHTML = '';
                submitBtn.disabled = true;
            }

            accountInput.addEventListener('input', resetPreview);

            verifyBtn.addEventListener('click', async function () {
                const accountNumber = accountInput.value.trim();
                if (!accountNumber) {
                    resetPreview();
                    return;
                }

                verifyBtn.disabled = true;
                verifyBtn.textContent = 'Verificando...';

                try {
                    const response = await fetch(`/Cashier/PreviewAccount?accountNumber=${encodeURIComponent(accountNumber)}`);
                    const data = await response.json();

                    if (data.success) {
                        const isActive = data.status === 'Activa';
                        previewBox.className = `mb-3 p-3 rounded border ${isActive ? 'border-success bg-success-subtle' : 'border-danger bg-danger-subtle'}`;
                        previewBox.innerHTML = `
                            <p class="mb-1"><strong>Titular:</strong> ${data.holderName}</p>
                            <p class="mb-0"><strong>Estado de la cuenta:</strong> ${data.status}</p>
                        `;
                        previewBox.classList.remove('d-none');
                        submitBtn.disabled = !isActive;
                    } else {
                        previewBox.className = 'mb-3 p-3 rounded border border-danger bg-danger-subtle';
                        previewBox.innerHTML = `<p class="mb-0 text-danger">${data.message}</p>`;
                        previewBox.classList.remove('d-none');
                        submitBtn.disabled = true;
                    }
                } catch (err) {
                    previewBox.className = 'mb-3 p-3 rounded border border-danger bg-danger-subtle';
                    previewBox.innerHTML = `<p class="mb-0 text-danger">No fue posible verificar la cuenta. Intente nuevamente.</p>`;
                    previewBox.classList.remove('d-none');
                    submitBtn.disabled = true;
                } finally {
                    verifyBtn.disabled = false;
                    verifyBtn.textContent = 'Verificar';
                }
            });
        })();
    </script>
}