@{
    ViewData["Title"] = "Activación de Cuenta";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="card border-0">
            <div class="card-body text-center p-5">

                @if (ViewBag.Error != null)
                {
                    <div class="mb-4">
                        <span style="font-size: 4rem;">❌</span>
                    </div>
                    <h2 class="text-danger fw-bold mb-3">Error de Activación</h2>
                    <p class="text-muted mb-4">@ViewBag.Error</p>
                    <hr />
                    <p class="text-muted small">Por favor, solicite un nuevo enlace o intente nuevamente.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary mt-2 px-4">Volver al Inicio</a>
                }
                else
                {
                    <div class="mb-4">
                        <span style="font-size: 4rem;">✅</span>
                    </div>
                    <h2 class="text-success fw-bold mb-3">¡Cuenta Activada!</h2>
                    <p class="text-muted mb-4">@ViewBag.Message</p>
                    <hr />
                    <p class="text-muted small">Bienvenido a Artemis Banking Pro. Todo está listo para usted.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-success mt-2 px-5">Iniciar Sesión</a>
                }

            </div>
        </div>
    </div>
</div>