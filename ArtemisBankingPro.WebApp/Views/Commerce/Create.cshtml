@model ArtemisBankingPro.WebApp.ViewModels.CreateCommerceViewModel

@{
    ViewData["Title"] = "Afiliar Nuevo Comercio";
}

<div class="d-flex align-items-center mb-3">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">&larr; Volver al inicio</a>
</div>

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold">🏛️ Afiliar Nuevo Comercio</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="BusinessName" class="form-label fw-semibold">Nombre del Comercio</label>
                            <input asp-for="BusinessName" class="form-control" placeholder="Ej. Supermercado El Ahorro" />
                            <span asp-validation-for="BusinessName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RNC" class="form-label fw-semibold">RNC (9 dígitos)</label>
                            <input asp-for="RNC" class="form-control" placeholder="Ej. 101001001" />
                            <span asp-validation-for="RNC" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="Ej. contacto@comercio.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">Contraseña de Usuario</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Mínimo 6 caracteres" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold">Teléfono de Contacto</label>
                            <input asp-for="Phone" class="form-control" placeholder="Ej. 809-555-0199" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold">Dirección Física</label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Ej. Av. Winston Churchill No. 109, Santo Domingo"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">Guardar Comercio</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
