@model ArtemisBankingPro.Application.DTOs.Account.CreateSecondaryAccountDto
@{
    ViewData["Title"] = "Crear Cuenta Secundaria";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Asignar Cuenta Secundaria</h2>
    <p class="text-muted">La cuenta se creará con estado Activo y un número único generado aleatoriamente.</p>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form asp-action="CreateSecondary" method="post">
        <div class="mb-3">
            <label asp-for="ClientCedula" class="form-label">Cédula del Cliente</label>
            <input asp-for="ClientCedula" class="form-control" required placeholder="000-0000000-0" />
            <span asp-validation-for="ClientCedula" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="InitialBalance" class="form-label">Balance Inicial (Crédito)</label>
            <div class="input-group">
                <span class="input-group-text">RD$</span>
                <input asp-for="InitialBalance" class="form-control" type="number" step="0.01" min="0" value="0.00" />
            </div>
            <span asp-validation-for="InitialBalance" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Crear Cuenta</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>