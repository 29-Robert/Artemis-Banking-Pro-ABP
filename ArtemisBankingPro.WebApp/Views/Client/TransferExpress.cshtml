@model ArtemisBankingPro.WebApp.ViewModels.ExpressTransactionViewModel
@{
    ViewData["Title"] = "Transacción Express";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Transacción Express</h2>
    <p class="text-muted">Transfiere fondos de manera inmediata a cualquier otra cuenta de ahorros activa registrada en el sistema.</p>

    <div class="card shadow-sm border-0 mt-3">
        <div class="card-body p-4">
            <form asp-action="TransferExpress" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Cuenta de Origen</label>
                    <select asp-for="SourceAccountNumber" class="form-select" required>
                        <option value="">Seleccione cuenta origen...</option>
                        @foreach (var acc in (IEnumerable<ArtemisBankingPro.Application.DTOs.Account.SavingsAccountListItemDto>)ViewBag.Accounts)
                        {
                            <option value="@acc.AccountNumber">@acc.AccountNumber - RD$ @acc.Balance.ToString("N2")</option>
                        }
                    </select>
                    <span asp-validation-for="SourceAccountNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Número de Cuenta Destino</label>
                    <input asp-for="DestinationAccountNumber" class="form-control" placeholder="Ej. 123456789" required />
                    <span asp-validation-for="DestinationAccountNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Monto a Transferir (RD$)</label>
                    <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="Ej. 500.00" required />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Ejecutar Transferencia</button>
                </div>
            </form>
        </div>
    </div>
</div>
